<?xml version="1.0" encoding="utf-8"?>
<!--
  The filled equals key. Its face is already jade, so the ripple lightens rather
  than tints: the same white the glyph is drawn in. See widget_key_ripple.xml.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_ripple_on_accent">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
