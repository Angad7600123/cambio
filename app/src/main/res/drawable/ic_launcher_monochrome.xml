<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer, tinted a single colour by the launcher.

  The full foreground cannot serve here: its glyphs are white *on* dark circles and a
  jade pill, and flattening all three to one colour would fill the circles solid and
  swallow the glyphs inside them. So this keeps only the marks themselves — plus,
  conversion arrows, equals — which stay legible whatever tint is applied, in the
  same three positions as the full icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FF000000">

    <path
        android:pathData="M31.5,41 L46.5,41 M39,33.5 L39,48.5"
        android:strokeColor="#FF000000"
        android:strokeWidth="4.4"
        android:strokeLineCap="round" />

    <path
        android:pathData="M31,63.5 L45.5,63.5 M42,60 L45.5,63.5 L42,67
                          M47,71.5 L32.5,71.5 M36,68 L32.5,71.5 L36,75"
        android:strokeColor="#FF000000"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M61,49 L75,49 M61,59 L75,59"
        android:strokeColor="#FF000000"
        android:strokeWidth="4.4"
        android:strokeLineCap="round" />
</vector>
