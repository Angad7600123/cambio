<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget colours that must exist as Android resources.

  A RemoteViews background has to be a drawable, and the widget's loading layout
  is plain XML, so those colours live here. Everything else the widget draws uses
  day/night ColorProviders declared in CambioWidget.kt alongside the app palette.

  The matching values-night file supplies the dark variant, which is what makes
  the widget follow the system theme with no code involved.

  These values mirror ui/theme/Color.kt. Light values here; dark in values-night.
-->
<resources>
    <color name="widget_canvas">#FFFFFFFF</color>
    <color name="widget_key">#FFEFEFF3</color>
    <color name="widget_operator_key">#FFDFDFE6</color>
    <color name="widget_accent">#FF0F6E56</color>
    <color name="widget_text_primary">#FF000000</color>
    <color name="widget_text_secondary">#FF6C6C70</color>

    <!--
      Press feedback, tinted with each key's own glyph colour so the widget speaks
      the same language as the app's halo: coral for the destructive pair, white on
      the filled equals, plain foreground everywhere else. A ripple washes the whole
      face rather than ringing the edge, so these sit below the app's peak alpha.
    -->
    <color name="widget_ripple">#331A1A1C</color>
    <color name="widget_ripple_destructive">#40B3392A</color>
    <color name="widget_ripple_on_accent">#3DFFFFFF</color>
</resources>
