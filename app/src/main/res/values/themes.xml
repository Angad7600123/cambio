<?xml version="1.0" encoding="utf-8"?>
<!--
  A minimal launch theme. The real UI is themed entirely in Compose
  (ui/theme/Theme.kt); this exists only so the window has the right background
  before Compose draws, which is what prevents a white flash on a dark device.
-->
<resources>
    <style name="Theme.Cambio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/widget_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
