# Formatting rules, enforced by ktlint via Spotless (./gradlew spotlessApply).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_standard_function-naming = disabled
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,yml,yaml,json}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
